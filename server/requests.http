### ============================================
### AUTH
### ============================================

### Health Check
GET http://localhost:3001/api/health

### Register - Owner Account
POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Test Owner",
  "username": "testowner1",
  "email": "testowner1@example.com",
  "password": "TestPass123!"
}

### Register - Collaborator Account
POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Test Collaborator",
  "username": "testcollab1",
  "email": "testcollab1@example.com",
  "password": "TestPass123!"
}

### Register - Username Too Short (should fail)
POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Validation Test",
  "username": "abc",
  "email": "validation1@example.com",
  "password": "TestPass123!"
}

### Register - Invalid Username Characters (should fail)
POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Validation Test",
  "username": "bad user!",
  "email": "validation2@example.com",
  "password": "TestPass123!"
}

### Register - Weak Password No Uppercase (should fail)
POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Validation Test",
  "username": "validation3",
  "email": "validation3@example.com",
  "password": "testpass123!"
}

### Register - Weak Password No Number (should fail)
POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Validation Test",
  "username": "validation4",
  "email": "validation4@example.com",
  "password": "TestPass!!"
}

### Register - Weak Password No Special Char (should fail)
POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Validation Test",
  "username": "validation5",
  "email": "validation5@example.com",
  "password": "TestPass123"
}

### Login - Owner
POST http://localhost:3001/api/auth/login
Content-Type: application/json

{
  "email": "testowner1@example.com",
  "password": "TestPass123!"
}

### Login - Collaborator
POST http://localhost:3001/api/auth/login
Content-Type: application/json

{
  "email": "testcollab1@example.com",
  "password": "TestPass123!"
}

### Login - Wrong Password (should fail)
POST http://localhost:3001/api/auth/login
Content-Type: application/json

{
  "email": "testowner1@example.com",
  "password": "WrongPassword1!"
}

### Logout
POST http://localhost:3001/api/auth/logout


### ============================================
### PROJECTS
### Run "Login - Owner" above first to establish session cookie
### ============================================

### Get All Projects
GET http://localhost:3001/api/projects

### Create Project
POST http://localhost:3001/api/projects
Content-Type: application/json

{
  "name": "Test Project",
  "description": "A project for manual API testing"
}

### Get Single Project
# Replace :id with an actual project ID from Create Project response
GET http://localhost:3001/api/projects/:id

### Update Project
# Replace :id with an actual project ID
PUT http://localhost:3001/api/projects/:id
Content-Type: application/json

{
  "name": "Test Project",
  "description": "Updated description for manual API testing",
  "status": "active"
}

### Invite Collaborator
# Replace :id with an actual project ID
PUT http://localhost:3001/api/projects/:id/invite
Content-Type: application/json

{
  "email": "testcollab1@example.com"
}

### Delete Project
# Replace :id with an actual project ID
DELETE http://localhost:3001/api/projects/:id


### ============================================
### TASKS
### Run "Login - Owner" above first to establish session cookie
### ============================================

### Get All Tasks
# Replace :projectId with an actual project ID
GET http://localhost:3001/api/projects/:projectId/tasks

### Create Task
# Replace :projectId with an actual project ID
POST http://localhost:3001/api/projects/:projectId/tasks
Content-Type: application/json

{
  "title": "Test Task",
  "description": "A task for manual API testing",
  "status": "To Do"
}

### Get Single Task
# Replace :projectId and :id with actual IDs
GET http://localhost:3001/api/projects/:projectId/tasks/:id

### Update Task
# Replace :projectId and :id with actual IDs
PUT http://localhost:3001/api/projects/:projectId/tasks/:id
Content-Type: application/json

{
  "title": "Test Task",
  "description": "Updated description for manual API testing",
  "status": "In Progress"
}

### Delete Task
# Replace :projectId and :id with actual IDs
DELETE http://localhost:3001/api/projects/:projectId/tasks/:id


### ============================================
### COLLABORATOR PERMISSION CHECKS
### Run "Login - Collaborator" above first to establish session cookie
### ============================================

### Get All Projects - Collaborator (should include owner's project)
GET http://localhost:3001/api/projects

### Get All Tasks - Collaborator (should succeed)
# Replace :projectId with the project the collaborator was invited to
GET http://localhost:3001/api/projects/:projectId/tasks

### Update Task - Collaborator (should succeed)
# Replace :projectId and :id with actual IDs
PUT http://localhost:3001/api/projects/:projectId/tasks/:id
Content-Type: application/json

{
  "status": "In Progress"
}

### Delete Task - Collaborator (should fail with 403)
# Replace :projectId and :id with actual IDs
DELETE http://localhost:3001/api/projects/:projectId/tasks/:id